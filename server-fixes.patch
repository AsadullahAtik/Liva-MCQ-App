diff --git a/src/test/java/com/livemcq/service/LoginThrottleTest.java b/src/test/java/com/livemcq/service/LoginThrottleTest.java
new file mode 100644
index 0000000..e18a2fe
--- /dev/null
+++ b/src/test/java/com/livemcq/service/LoginThrottleTest.java
@@ -0,0 +1,45 @@
+package com.livemcq.service;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.livemcq.web.ApiException;
+import java.time.Duration;
+import org.junit.jupiter.api.Test;
+
+class LoginThrottleTest {
+    private long t = 0;
+    private final LoginThrottle l = new LoginThrottle(5, Duration.ofMinutes(15), () -> t);
+
+    private boolean locked(String k) {
+        try {
+            l.check(k);
+            return false;
+        } catch (ApiException e) {
+            assertEquals(429, e.status);
+            return true;
+        }
+    }
+
+    @Test
+    void locksAfterFiveFailuresAndUnlocksLater() {
+        for (int i = 0; i < 4; i++) {
+            l.fail("101");
+            assertFalse(locked("101"));
+        }
+        l.fail(" 101 "); // ফাঁকা অংশ ধর্তব্য নয়
+        assertTrue(locked("101"));
+        assertFalse(locked("102"), "অন্য রোল আটকাবে না");
+        t += 14 * 60_000;
+        assertTrue(locked("101"));
+        t += 2 * 60_000;
+        assertFalse(locked("101"));
+    }
+
+    @Test
+    void successResetsCount() {
+        for (int i = 0; i < 4; i++) l.fail("101");
+        l.success("101");
+        for (int i = 0; i < 4; i++) l.fail("101");
+        assertFalse(locked("101"));
+    }
+}
