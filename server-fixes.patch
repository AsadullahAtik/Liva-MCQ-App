@@ -0,0 +1,44 @@
+package com.livemcq;
+
+import jakarta.annotation.PostConstruct;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.core.env.Environment;
+import org.springframework.core.env.Profiles;
+import org.springframework.stereotype.Component;
+
+/**
+ * চালুর সময় JWT secret যাচাই. ডিফল্ট (গিটহাবে খোলা) secret দিয়ে যে কেউ admin টোকেন বানাতে পারে.
+ * postgres প্রোফাইলে বা app.security.strict=true হলে ডিফল্ট secret থাকলে সার্ভার চালুই হয় না;
+ * লোকাল H2 ডেভেলপমেন্টে শুধু সতর্কবার্তা দেয়.
+ */
+@Component
+public class SecretsCheck {
+    static final String DEFAULT_SECRET = "change-this-secret-key-to-at-least-32-chars-long";
+    private static final Logger log = LoggerFactory.getLogger(SecretsCheck.class);
+
+    private final String secret;
+    private final boolean strict;
+    private final boolean demo;
+
+    public SecretsCheck(Environment env,
+                        @Value("${app.jwt.secret}") String secret,
+                        @Value("${app.security.strict:false}") boolean strictFlag,
+                        @Value("${app.seed.demo:true}") boolean demo) {
+        this.secret = secret;
+        this.strict = strictFlag || env.acceptsProfiles(Profiles.of("postgres"));
+        this.demo = demo;
+    }
+
+    @PostConstruct
+    void verify() {
+        if (DEFAULT_SECRET.equals(secret)) {
+            if (strict) throw new IllegalStateException("JWT_SECRET দেওয়া হয়নি: ডিফল্ট secret দিয়ে production চালানো যাবে না (কমপক্ষে ৩২ অক্ষরের নিজস্ব secret দিন)");
+            log.warn("⚠ ডিফল্ট JWT secret ব্যবহার হচ্ছে — শুধু লোকাল ডেভেলপমেন্টে চলবে. deploy-এর আগে JWT_SECRET দিন.");
+        }
+        if (demo && strict) {
+            log.warn("⚠ app.seed.demo=true: ডেমো অ্যাকাউন্ট (admin/admin ইত্যাদি) চালু আছে — আসল ব্যবহারে APP_SEED_DEMO=false দিন.");
+        }
+    }
+}
