diff --git a/src/main/java/com/livemcq/service/LoginThrottle.java b/src/main/java/com/livemcq/service/LoginThrottle.java
new file mode 100644
index 0000000..812c0c3
--- /dev/null
+++ b/src/main/java/com/livemcq/service/LoginThrottle.java
@@ -0,0 +1,69 @@
+package com.livemcq.service;
+
+import com.livemcq.web.ApiException;
+import java.time.Duration;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.LongSupplier;
+
+/**
+ * লগইনে পরপর ভুল পাসওয়ার্ড ঠেকানো (brute-force). এক রোলে {@code maxFails} বার ভুল হলে {@code lockFor} সময় লগইন বন্ধ (৪২৯).
+ * সফল লগইনে গণনা মুছে যায়. মেমরিতে থাকে, তাই এক instance-এর জন্য; একাধিক instance হলে Redis/DB-তে নিতে হবে.
+ */
+public class LoginThrottle {
+    private record State(int fails, long lockedUntil, long lastFail) {}
+
+    private static final int MAX_KEYS = 50_000;
+
+    private final int maxFails;
+    private final long lockMs;
+    private final LongSupplier clock;
+    private final Map<String, State> map = new ConcurrentHashMap<>();
+
+    public LoginThrottle() {
+        this(5, Duration.ofMinutes(15), System::currentTimeMillis);
+    }
+
+    public LoginThrottle(int maxFails, Duration lockFor, LongSupplier clock) {
+        this.maxFails = maxFails;
+        this.lockMs = lockFor.toMillis();
+        this.clock = clock;
+    }
+
+    /** তালাবন্ধ থাকলে ৪২৯ ছোঁড়ে. */
+    public void check(String key) {
+        State s = map.get(norm(key));
+        long now = clock.getAsLong();
+        if (s != null && s.lockedUntil() > now) {
+            long mins = Math.max(1, (s.lockedUntil() - now + 59_999) / 60_000);
+            throw new ApiException(429, "অনেকবার ভুল হয়েছে, " + mins + " মিনিট পরে চেষ্টা করুন");
+        }
+    }
+
+    public void fail(String key) {
+        long now = clock.getAsLong();
+        if (map.size() >= MAX_KEYS) prune(now);
+        map.merge(norm(key), new State(1, 0, now), (old, ignored) -> {
+            // লক শেষ হয়ে গেলে বা অনেকদিন আগের ভুল হলে নতুন করে গোনা
+            boolean stale = old.lockedUntil() != 0 ? old.lockedUntil() <= now : now - old.lastFail() > lockMs;
+            int n = stale ? 1 : old.fails() + 1;
+            return new State(n, n >= maxFails ? now + lockMs : 0, now);
+        });
+    }
+
+    public void success(String key) {
+        map.remove(norm(key));
+    }
+
+    private void prune(long now) {
+        for (Iterator<State> it = map.values().iterator(); it.hasNext(); ) {
+            State s = it.next();
+            if (s.lockedUntil() <= now && now - s.lastFail() > lockMs) it.remove();
+        }
+    }
+
+    private static String norm(String k) {
+        return k == null ? "" : k.trim().toLowerCase();
+    }
+}
